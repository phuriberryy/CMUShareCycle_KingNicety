{
  "name": "cmu-sharecycle",
  "version": "1.0.0",
  "private": true,
  "description": "CMU ShareCycle - ระบบแลกเปลี่ยนสินค้าสำหรับชุมชน CMU",
  "scripts": {
    "start": "bash scripts/start.sh",
    "start:backend": "bash scripts/start-backend.sh",
    "start:frontend": "bash scripts/start-frontend.sh",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "node --check backend/src/composition/app.js && node --check backend/src/composition/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "setup": "npm run install:all && echo '✅ ติดตั้ง dependencies สำเร็จ'",
    "email:setup": "cd backend && npm run email:setup",
    "email:gmail": "cd backend && npm run email:gmail",
    "email:update": "cd backend && npm run email:update",
    "test:email": "cd backend && npm run test:email"
  },
  "keywords": [
    "cmu",
    "sharecycle",
    "exchange",
    "sustainability"
  ],
  "author": "CMU ShareCycle Team G4",
  "license": "PRIVATE",
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
